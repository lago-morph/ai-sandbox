#!/usr/bin/env bash
# git credential helper (configured for https://github.com by setup).
# Answers `get` with the GitHub token from the secrets backend, read at call time so a
# rotated token is picked up immediately. `store` and `erase` are ignored.
set -euo pipefail
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
if [ -z "${AI_SANDBOX_LIB:-}" ]; then
  if [ -f "$here/../setup.sh" ]; then AI_SANDBOX_LIB=$(cd "$here/../lib" && pwd); else AI_SANDBOX_LIB=$HOME/.local/share/ai-sandbox/lib; fi
fi
# shellcheck source=../lib/common.sh
source "$AI_SANDBOX_LIB/common.sh"

[ "${1:-}" = get ] || exit 0
host=
while IFS= read -r line && [ -n "$line" ]; do
  case "$line" in host=*) host=${line#host=} ;; esac
done
[ "$host" = github.com ] || exit 0
config_load || exit 0
secrets_init
token=$(secret_get "$SECRET_GITHUB") || exit 0
printf 'username=x-access-token\npassword=%s\n' "$token"
