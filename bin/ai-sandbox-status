#!/usr/bin/env bash
# Usage: ai-sandbox-status [--brief]
# Health of every module installed on this host: one line per module, then the detail for any
# that aren't healthy, each with its troubleshooting doc. Run this first when something on the
# host isn't working. --brief prints only problems, and nothing when all is well (it runs as a
# SessionStart hook in every session, so it reads only local files and never fails).
# Exit (without --brief): 0 all healthy, 1 a module unhealthy, 2 one stopped on purpose.
set -uo pipefail
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
if [ -z "${AI_SANDBOX_LIB:-}" ]; then
  if [ -f "$here/../setup.sh" ]; then AI_SANDBOX_LIB=$(cd "$here/../lib" && pwd); else AI_SANDBOX_LIB=$HOME/.local/share/ai-sandbox/lib; fi
fi
brief=0
case "${1:-}" in --brief) brief=1 ;; '') ;; *) echo "usage: ai-sandbox-status [--brief]" >&2; exit 2 ;; esac
# shellcheck source=../lib/common.sh
source "$AI_SANDBOX_LIB/common.sh" || exit 0
# shellcheck source=../lib/modules.sh
source "$AI_SANDBOX_LIB/modules.sh" || exit 0
config_load >/dev/null 2>&1 || AI_SANDBOX_MODULES=${AI_SANDBOX_MODULES:-}

worst=0 summary=() details=()
for m in $(modules_installed); do
  note=""
  modules_listed | grep -qxF "$m" || note=" (installed, not listed)"
  cmd="ai-sandbox-$m-status"
  if ! command -v "$cmd" >/dev/null; then
    summary+=("$m: no status command ($cmd)$note"); continue
  fi
  out=$(timeout 10 "$cmd" 2>&1); rc=$?
  first=$(head -n1 <<<"$out")
  case $rc in
    0) summary+=("$m: ok, $first$note") ;;
    2) summary+=("$m: STOPPED ON PURPOSE: $first$note"); [ $worst -ge 2 ] || worst=2 ;;
    *) summary+=("$m: UNHEALTHY: $first$note"); [ $worst -ge 1 ] || worst=1 ;;
  esac
  if [ $rc != 0 ]; then
    details+=("--- $m (see Troubleshooting in $AI_SANDBOX_SHARE/modules/$m/README.md)" "$out")
  fi
done

if [ $brief = 1 ]; then
  [ $worst = 0 ] && exit 0
  for l in "${summary[@]}"; do case "$l" in *": ok, "*|*": no status command"*) ;; *) echo "ai-sandbox: $l" ;; esac; done
  echo "ai-sandbox: run ai-sandbox-status for details before changing anything."
  exit 0
fi
[ ${#summary[@]} -gt 0 ] || { echo "no modules installed"; exit 0; }
printf '%s\n' "${summary[@]}"
[ ${#details[@]} = 0 ] || printf '%s\n' "" "${details[@]}"
exit $worst
