#!/usr/bin/env bash
# Usage: ai-sandbox-secret has|describe|get|set NAME
# Front end to the configured secrets backend. `get` prints the value: only pipe it into
# the program that needs it, never print it to a terminal or log. `set` stores stdin (from a
# terminal it prompts without echoing).
set -euo pipefail
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
if [ -z "${AI_SANDBOX_LIB:-}" ]; then
  if [ -f "$here/../setup.sh" ]; then AI_SANDBOX_LIB=$(cd "$here/../lib" && pwd); else AI_SANDBOX_LIB=$HOME/.local/share/ai-sandbox/lib; fi
fi
# shellcheck source=../lib/common.sh
source "$AI_SANDBOX_LIB/common.sh"

cmd=${1:-}; name=${2:-}
[ -n "$cmd" ] && [ -n "$name" ] || die "usage: ai-sandbox-secret has|describe|get|set NAME"
config_require
secrets_init
case "$cmd" in
  has) secret_has "$name" ;;
  describe) secret_describe "$name"; echo ;;
  get) secret_get "$name" ;;
  set)
    if [ -t 0 ]; then
      read -rsp "value for $name (not shown): " v; echo >&2
      [ -n "$v" ] || die "empty value; nothing stored"
      printf '%s' "$v" | secret_set "$name"
    else
      secret_set "$name"
    fi ;;
  *) die "usage: ai-sandbox-secret has|describe|get|set NAME" ;;
esac
