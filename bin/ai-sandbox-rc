#!/usr/bin/env bash
# Usage: ai-sandbox-rc <repo>
# ExecStart of the rc@<repo> systemd unit: refreshes the repo's checkout, then runs
# `claude remote-control` in it with settings from the host config. Not meant to be run by hand.
set -euo pipefail
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
if [ -z "${AI_SANDBOX_LIB:-}" ]; then
  if [ -f "$here/../setup.sh" ]; then AI_SANDBOX_LIB=$(cd "$here/../lib" && pwd); else AI_SANDBOX_LIB=$HOME/.local/share/ai-sandbox/lib; fi
fi
# shellcheck source=../lib/common.sh
source "$AI_SANDBOX_LIB/common.sh"
config_require
secrets_init

name=${1:?usage: ai-sandbox-rc <repo>}
dir="$AI_SANDBOX_GIT_BASEDIR/$name"
export PATH="$AI_SANDBOX_BIN:$PATH"
cd "$dir"
rc-refresh --switch "$name" || warn "refresh of $name failed; starting anyway"

export CLAUDE_REMOTE_CONTROL_SESSION_NAME_PREFIX=${AI_SANDBOX_NAME_PREFIX:-$(hostname -s)}
if secret_has "$SECRET_CLAUDE_TOKEN"; then
  # Untested: assumes Remote Control accepts a `claude setup-token` token.
  CLAUDE_CODE_OAUTH_TOKEN=$(secret_get "$SECRET_CLAUDE_TOKEN")
  export CLAUDE_CODE_OAUTH_TOKEN
fi

args=(remote-control --name "$(rc_display_name "$name")" --spawn "$AI_SANDBOX_SPAWN_MODE")
[ "$AI_SANDBOX_SPAWN_MODE" = worktree ] && args+=(--no-create-session-in-dir)
[ -n "$AI_SANDBOX_PERMISSION_MODE" ] && args+=(--permission-mode "$AI_SANDBOX_PERMISSION_MODE")
exec claude "${args[@]}"
