#!/usr/bin/env bash
# Usage: rc-start <owner/repo | repo>
# Serves a repo over Claude Remote Control:
#   1. Clones owner/repo into the git base dir if it isn't there.
#   2. Puts the main checkout on the default branch and fast-forwards it.
#   3. Marks the checkout trusted for Claude Code.
#   4. Starts systemd user unit rc@<repo>. It is NOT enabled at boot (only the ai-sandbox
#      repo's own unit is, via setup). It refreshes the checkout before each start.
# Rerunning on a repo that is already served just refreshes its checkout.
# Manage: systemctl --user status|restart|stop rc@<repo>; journalctl --user -u rc@<repo>
set -euo pipefail
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
if [ -z "${AI_SANDBOX_LIB:-}" ]; then
  if [ -f "$here/../setup.sh" ]; then AI_SANDBOX_LIB=$(cd "$here/../lib" && pwd); else AI_SANDBOX_LIB=$HOME/.local/share/ai-sandbox/lib; fi
fi
# shellcheck source=../lib/common.sh
source "$AI_SANDBOX_LIB/common.sh"
config_require

arg=${1:?usage: rc-start <owner/repo | repo>}
if [[ "$arg" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then
  name=${arg##*/}
  slug=$arg
elif [[ "$arg" =~ ^[A-Za-z0-9_.-]+$ ]]; then
  name=$arg
  slug=
else
  die "expected owner/repo or a repo directory name under $AI_SANDBOX_GIT_BASEDIR, got: $arg"
fi
[[ "$name" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]] || die "unsupported repo name: $name"
dir="$AI_SANDBOX_GIT_BASEDIR/$name"

if [ ! -d "$dir" ]; then
  [ -n "$slug" ] || die "$dir does not exist; pass owner/$name to clone it"
  mkdir -p "$AI_SANDBOX_GIT_BASEDIR"
  gh repo clone "$slug" "$dir"
fi
git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "$dir is not a git checkout"

rc-refresh --switch "$name"
claude_trust_dir "$dir"

unit="rc@$name.service"
if systemctl --user is-active -q "$unit"; then
  echo "$unit already running; checkout refreshed"
else
  systemctl --user reset-failed "$unit" 2>/dev/null || true
  systemctl --user start "$unit"
  echo "started $unit: Remote Control '$(rc_display_name "$name")' serving $dir ($AI_SANDBOX_SPAWN_MODE mode)"
fi
